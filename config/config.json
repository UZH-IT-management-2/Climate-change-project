{
  "app": {
    "name": "Swiss Historical Climate Explorer",
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "de", "fr", "it"]
  },
  "baseline": {
    "start": 1961,
    "end": 1990,
    "label": "1961–1990"
  },
  "map": {
    "center": [46.82, 8.23],
    "zoom": 8,
    "minZoom": 7,
    "maxZoom": 13,
    "countryBounds": [[45.80, 5.95], [47.82, 10.50]],
    "overlayBounds": [[45.75, 5.75], [47.88, 10.75]],
    "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "tileAttribution": "&copy; OpenStreetMap contributors"
  },
  "geolocation": {
    "enabled": true,
    "url": "https://ipwho.is/",
    "timeoutMs": 3500,
    "swissCountryCode": "CH",
    "regionalZoom": 10
  },
  "data": {
    "stacBase": "https://data.geo.admin.ch/api/stac/v1",
    "gridCollection": "ch.meteoschweiz.ogd-surface-derived-grid",
    "stationCollection": "ch.meteoschweiz.ogd-nbcn",
    "manifest": "data/manifest.json",
    "stations": "data/stations/hot-days.json",
    "samplesDirectory": "data/samples",
    "overlayDirectory": "data/overlays"
  },
  "playback": {
    "intervalMs": 850,
    "preloadAdjacentYears": true
  },
  "variables": {
    "temperature": {
      "dataset": "TabsY",
      "assetPattern": "tabsy_ch01r",
      "units": "°C",
      "decimals": 1,
      "absoluteDomain": [-12, 14],
      "anomalyDomain": [-4, 4],
      "absolutePalette": ["#263b70", "#277da1", "#90be6d", "#f9c74f", "#d73027"],
      "anomalyPalette": ["#2166ac", "#67a9cf", "#f7f7f7", "#ef8a62", "#b2182b"]
    },
    "precipitation": {
      "dataset": "RhiresY",
      "assetPattern": "rhiresy_ch01r",
      "units": "mm",
      "decimals": 0,
      "absoluteDomain": [400, 3600],
      "anomalyDomain": [-1000, 1000],
      "absolutePalette": ["#fff7bc", "#addd8e", "#41b6c4", "#2c7fb8", "#253494"],
      "anomalyPalette": ["#8c510a", "#d8b365", "#f5f5f5", "#5ab4ac", "#01665e"]
    },
    "sunshine": {
      "dataset": "SrelrecY1961",
      "assetPattern": "srelrecy1961_ch02",
      "units": "%",
      "decimals": 0,
      "absoluteDomain": [30, 75],
      "anomalyDomain": [-20, 20],
      "absolutePalette": ["#4d4d4d", "#969696", "#d9d9d9", "#fee08b", "#fdae61"],
      "anomalyPalette": ["#4d4d4d", "#a6a6a6", "#f7f7f7", "#ffe082", "#f5a623"]
    },
    "hotDays": {
      "dataset": "NBCN ths30xy0",
      "units": "days",
      "decimals": 0,
      "absoluteDomain": [0, 45],
      "anomalyDomain": [-12, 24],
      "absolutePalette": ["#fff7bc", "#fec44f", "#fe9929", "#ec7014", "#b10026"],
      "anomalyPalette": ["#2166ac", "#92c5de", "#f7f7f7", "#f4a582", "#b2182b"]
    }
  }
}
